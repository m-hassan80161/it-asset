# ---- Postgres ----
POSTGRES_USER=itam_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=itam_platform

# ---- Backend ----
DATABASE_URL=postgresql://itam_admin:changeme@postgres:5432/itam_platform
PORT=3000
JWT_SECRET=replace_with_a_long_random_string
NODE_ENV=production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters

# ---- Email registration verification ----
EMAIL_VERIFICATION_SECRET=replace_with_a_random_secret_at_least_32_characters
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=itam@example.com
MAIL_PASSWORD=replace_me
MAIL_FROM="IT Asset Platform <itam@example.com>"

FRONTEND_ORIGIN=http://localhost:5173
AGENT_UPDATE_PUBLIC_KEY=
AGENT_RELEASES_DIR=/data/agent-releases

# ---- Frontend ----
VITE_API_BASE_URL=/api/v1

# ---- pgAdmin (optional, docker compose --profile tools up) ----
PGADMIN_EMAIL=admin@local.test
PGADMIN_PASSWORD=changeme
