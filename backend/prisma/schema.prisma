// =========================================================
// IT Asset Management / AD Sync / Onboarding Platform
// PostgreSQL schema (Prisma)
// =========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// 1. INVENTORY & ASSET MANAGEMENT
// ---------------------------------------------------------

model Device {
  id           String   @id @default(uuid())
  computerName String   @unique
  loggedInUser String?
  osName       String?
  osVersion    String?
  osBuild      String?
  domain       String?
  formFactor   DeviceFormFactor?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cpu              CpuInfo?
  motherboard      MotherboardInfo?
  ramModules       RamModule[]
  disks            DiskDrive[]
  software         InstalledSoftware[]
  gitConfig        GitConfig?
  complianceAlerts ComplianceAlert[]
  components       DeviceComponent[]
  componentHistory DeviceComponentHistory[]

  @@index([computerName])
}

model WindowsAgent {
  id              String   @id @default(uuid())
  installId       String   @unique
  computerName    String
  primaryMac      String?
  macAddresses    String[] @default([])
  loggedInUser    String?
  domain          String?
  osName          String?
  osVersion       String?
  agentVersion    String
  snapshot        Json?
  secretHash      String   @unique
  lastSeenAt      DateTime @default(now())
  lastInventoryAt DateTime?
  isEnabled       Boolean  @default(true)
  enrolledAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  serverChangeCredentials WindowsAgentServerChangeCredential[]

  @@index([lastSeenAt])
  @@index([primaryMac])
}

model WindowsAgentServerChangeCredential {
  id            String       @id @default(uuid())
  tokenHash     String       @unique
  windowsAgentId String
  agent          WindowsAgent @relation(fields: [windowsAgentId], references: [id], onDelete: Cascade)
  createdById   String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime     @default(now())

  @@index([windowsAgentId, expiresAt])
  @@index([expiresAt, consumedAt])
}

model WindowsAgentEnrollment {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  maxUses     Int       @default(1)
  useCount    Int       @default(0)
  createdById String
  createdAt   DateTime  @default(now())

  @@index([expiresAt, consumedAt])
}

model WindowsAgentRelease {
  id          String   @id @default(uuid())
  version     String   @unique
  notes       String   @default("")
  fileName    String
  storagePath String
  sha256      String
  signature   String
  publishedBy String
  publishedAt DateTime @default(now())

  @@index([publishedAt])
}

enum BranchPatternSource {
  DOMAIN
  COMPUTER_NAME
}

model BranchPattern {
  id          String              @id @default(uuid())
  source      BranchPatternSource
  pattern     String
  branch      String
  createdById String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([source, pattern])
  @@index([branch])
}

model Branch {
  name      String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAccount {
  id                       String                  @id
  username                 String                  @unique
  passwordHash             String?
  fullName                 String                  @default("System Administrator")
  phone                    String?
  dashboardPreferences     Json?
  role                     UserRole                @default(SUPER_ADMIN)
  authProvider             AuthProvider            @default(LOCAL)
  branch                   String?
  managedBranches          String[]                @default([])
  isActive                 Boolean                 @default(true)
  deleteAfter              DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  sessions                 AdminSession[]
  cpanelAccount            CpanelAccount?
  ticketsCreated           Ticket[]                @relation("TicketRequester")
  ticketsAssigned          Ticket[]                @relation("TicketAssignedAdmin")
  ticketsResolved          Ticket[]                @relation("TicketResolvedAdmin")
  ticketsManaged           Ticket[]                @relation("TicketManager")
  ticketComments           TicketComment[]
  knowledgeArticles        KnowledgeArticle[]      @relation("KnowledgeArticleAuthor")
  transferRequestsSent     TicketTransferRequest[] @relation("TicketTransferRequester")
  transferRequestsReceived TicketTransferRequest[] @relation("TicketTransferRecipient")
  trackedAssetsCreated     TrackedAsset[]          @relation("TrackedAssetCreator")
  assetLocationChanges    AssetLocationHistory[]  @relation("AssetLocationChanger")
  assetMaintenanceCreated AssetMaintenance[]      @relation("AssetMaintenanceCreator")

  @@index([isActive, deleteAfter])
}

enum AuthProvider {
  LOCAL
  CPANEL
}

enum CpanelAccountStatus {
  ACTIVE
  SUSPENDED
  MISSING
}

model CpanelAccount {
  username               String              @id
  domain                 String
  hostingAccountUsername String?
  status                 CpanelAccountStatus
  lastSyncedAt           DateTime            @default(now())
  lastSeenAt             DateTime            @default(now())
  itamAccountId          String?             @unique
  itamAccount            AdminAccount?       @relation(fields: [itamAccountId], references: [id], onDelete: SetNull)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([status])
  @@index([lastSeenAt])
  @@index([hostingAccountUsername])
}

enum UserRole {
  EMPLOYEE
  ADMIN
  MANAGER
  SUPER_ADMIN
}

model AdminSession {
  id        String       @id @default(uuid())
  tokenHash String       @unique
  adminId   String
  admin     AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime     @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

model EmailVerificationChallenge {
  id              String   @id @default(uuid())
  email           String   @unique
  codeHash        String
  expiresAt       DateTime
  lastSentAt      DateTime
  windowStartedAt DateTime
  sendsInWindow   Int      @default(1)
  attempts        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model CpuInfo {
  id            String @id @default(uuid())
  deviceId      String @unique
  device        Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  model         String
  cores         Int
  threads       Int
  clockSpeedMhz Int
  architecture  String
}

model MotherboardInfo {
  id           String  @id @default(uuid())
  deviceId     String  @unique
  device       Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  manufacturer String
  model        String
  serialNumber String?
}

model DeviceComponent {
  id             String                   @id @default(uuid())
  deviceId       String
  device         Device                   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  source         DeviceComponentSource    @default(MANUAL)
  category       String
  name           String
  manufacturer   String?
  model          String?
  sizeInches     Float?
  details        String?
  specifications Json                     @default("{}")
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  history        DeviceComponentHistory[]

  @@index([deviceId])
}

enum DeviceComponentSource {
  INVENTORY
  MANUAL
}

enum DeviceComponentAction {
  ADDED
  UPDATED
  REMOVED
}

model DeviceComponentHistory {
  id            String                @id @default(uuid())
  deviceId      String
  device        Device                @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  componentId   String?
  component     DeviceComponent?      @relation(fields: [componentId], references: [id], onDelete: SetNull)
  componentName String
  action        DeviceComponentAction
  previousValue Json?
  newValue      Json?
  changedAt     DateTime              @default(now())

  @@index([deviceId, changedAt])
  @@index([componentId])
}

enum AssetType {
  PRINTER
  SCANNER
  PC
  MONITOR
  OTHER
}

model AssetCodeCounter {
  type       AssetType @id
  lastNumber Int       @default(0)
}

model TrackedAsset {
  id            String                 @id @default(uuid())
  assetCode     String                 @unique
  type          AssetType
  modelName     String
  serialNumber  String?
  manufacturerSerialNumber String?
  location      String
  branch        String?
  department    String?
  employeeId    String?
  employee      AssetEmployee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     AdminAccount?          @relation("TrackedAssetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  locationHistory AssetLocationHistory[]
  maintenance   AssetMaintenance[]
  photos        AssetPhoto[]

  @@index([type, modelName])
  @@index([serialNumber])
  @@index([manufacturerSerialNumber])
  @@index([location])
  @@index([branch])
  @@index([employeeId])
}

model AssetEmployee {
  id        String         @id @default(uuid())
  name      String
  email     String?        @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  assets    TrackedAsset[]
}

model AssetLocationHistory {
  id             String        @id @default(uuid())
  assetId        String
  asset          TrackedAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromLocation   String?
  toLocation     String
  fromDepartment String?
  toDepartment   String?
  fromEmployeeName  String?
  fromEmployeeEmail String?
  toEmployeeName    String?
  toEmployeeEmail   String?
  changedById    String?
  changedBy      AdminAccount? @relation("AssetLocationChanger", fields: [changedById], references: [id], onDelete: SetNull)
  changedByName  String
  changedAt      DateTime      @default(now())

  @@index([assetId, changedAt])
}

model AssetMaintenance {
  id                 String        @id @default(uuid())
  assetId            String
  asset              TrackedAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  maintenanceDate    DateTime      @default(now())
  summary            String
  details            String?
  createdById        String?
  createdBy          AdminAccount? @relation("AssetMaintenanceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName      String
  createdAt          DateTime      @default(now())
  invoices           AssetMaintenanceInvoice[]

  @@index([assetId, maintenanceDate])
}

model AssetMaintenanceInvoice {
  id            String           @id @default(uuid())
  maintenanceId String
  maintenance   AssetMaintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  fileName      String
  fileData      String           @db.Text
  mimeType      String
  fileSize      Int
  createdAt     DateTime         @default(now())

  @@index([maintenanceId])
}

model AssetPhoto {
  id               String       @id @default(uuid())
  assetId          String
  asset            TrackedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fileName         String
  fileData         String       @db.Text
  mimeType         String
  fileSize         Int
  caption          String?
  location         String
  department       String?
  employeeName     String?
  employeeEmail    String?
  uploadedByName   String
  createdAt        DateTime     @default(now())

  @@index([assetId, createdAt])
}

model RamModule {
  id           String  @id @default(uuid())
  deviceId     String
  device       Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  capacityGb   Float
  speedMhz     Int
  serialNumber String?
  slot         String?

  @@index([deviceId])
}

enum DiskType {
  SSD
  HDD
  NVME
  UNKNOWN
}

enum DeviceFormFactor {
  LAPTOP
  PC
  UNKNOWN
}

model DiskDrive {
  id           String   @id @default(uuid())
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type         DiskType @default(UNKNOWN)
  serialNumber String?
  totalSpaceGb Float
  freeSpaceGb  Float

  @@index([deviceId])
}

enum ComplianceStatus {
  UP_TO_DATE
  OUTDATED
  MISSING
  NOT_TRACKED
}

model InstalledSoftware {
  id               String           @id @default(uuid())
  deviceId         String
  device           Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name             String
  version          String
  publisher        String?
  installDate      DateTime?
  masterSoftwareId String?
  masterSoftware   MasterSoftware?  @relation(fields: [masterSoftwareId], references: [id])
  complianceStatus ComplianceStatus @default(NOT_TRACKED)
  lastCheckedAt    DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([deviceId])
  @@index([name])
  @@index([masterSoftwareId])
}

model MasterSoftware {
  id                 String              @id @default(uuid())
  name               String              @unique
  minRequiredVersion String
  isMandatory        Boolean             @default(false)
  description        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  installedSoftware  InstalledSoftware[]

  @@index([name])
}

model ComplianceAlert {
  id             String   @id @default(uuid())
  deviceId       String
  device         Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  softwareName   String
  newVersion     String
  currentVersion String?
  laggingCount   Int      @default(0)
  message        String
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([deviceId])
  @@index([resolved])
}

model GitConfig {
  id            String   @id @default(uuid())
  deviceId      String   @unique
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  userName      String?
  userEmail     String?
  gitVersion    String?
  sshPublicKeys String[] // array of public key fingerprints/contents
}

// ---------------------------------------------------------
// 2. ACTIVE DIRECTORY SYNC
// ---------------------------------------------------------

model AdOrganizationalUnit {
  id                String   @id @default(uuid())
  distinguishedName String   @unique
  name              String
  parentDn          String?
  excluded          Boolean  @default(false)
  lastSyncedAt      DateTime @default(now())

  users AdUser[]
}

model AdGroup {
  id                String   @id @default(uuid())
  distinguishedName String   @unique
  name              String
  description       String?
  excluded          Boolean  @default(false)
  lastSyncedAt      DateTime @default(now())

  members AdUserGroup[]
}

model AdUser {
  id                String                @id @default(uuid())
  distinguishedName String                @unique
  sAMAccountName    String                @unique
  firstName         String?
  lastName          String?
  email             String?
  managerDn         String?
  manager           AdUser?               @relation("ManagerToReports", fields: [managerDn], references: [distinguishedName])
  directReports     AdUser[]              @relation("ManagerToReports")
  ouId              String?
  ou                AdOrganizationalUnit? @relation(fields: [ouId], references: [id])
  isServiceAccount  Boolean               @default(false)
  excluded          Boolean               @default(false)
  lastSyncedAt      DateTime              @default(now())

  groups             AdUserGroup[]
  onboardingRequests OnboardingRequest[]
}

enum TicketCategory {
  HARDWARE
  SOFTWARE
  NETWORK
  PRINTER
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id                    String                  @id @default(uuid())
  ticketNumber          Int                     @unique @default(autoincrement())
  title                 String
  description           String
  category              TicketCategory
  priority              TicketPriority          @default(MEDIUM)
  status                TicketStatus            @default(OPEN)
  requesterId           String?
  requester             AdminAccount?           @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  requesterUsername     String                  @default("unknown")
  requesterName         String                  @default("Unknown user")
  requesterEmail        String?
  requesterPhone        String?
  requesterLocation     String?
  branch                String
  departmentId          String?
  remoteSupportType     RemoteSupportType?
  remoteSupportId       String?
  assignedAdminId       String?
  assignedAdmin         AdminAccount?           @relation("TicketAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  assignedAdminName     String?
  assignedAdminUsername String?
  resolvedById          String?
  resolvedBy            AdminAccount?           @relation("TicketResolvedAdmin", fields: [resolvedById], references: [id], onDelete: SetNull)
  managerId             String?
  manager               AdminAccount?           @relation("TicketManager", fields: [managerId], references: [id], onDelete: SetNull)
  attachments           TicketAttachment[]
  comments              TicketComment[]
  transferRequests      TicketTransferRequest[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  resolvedAt            DateTime?
  assignedAt            DateTime?
  closedAt              DateTime?
  waitingUserStartedAt  DateTime?
  waitingUserDurationMs Float                   @default(0)

  @@index([requesterId])
  @@index([assignedAdminId])
  @@index([resolvedById])
  @@index([managerId])
  @@index([status])
  @@index([branch])
}

enum TicketTransferRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model TicketTransferRequest {
  id                 String                      @id @default(uuid())
  ticketId           String
  ticket             Ticket                      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  requestedByAdminId String?
  requestedByAdmin   AdminAccount?               @relation("TicketTransferRequester", fields: [requestedByAdminId], references: [id], onDelete: SetNull)
  requesterName      String
  requesterUsername  String
  targetAdminId      String?
  targetAdmin        AdminAccount?               @relation("TicketTransferRecipient", fields: [targetAdminId], references: [id], onDelete: SetNull)
  targetName         String
  targetUsername     String
  status             TicketTransferRequestStatus @default(PENDING)
  message            String?
  createdAt          DateTime                    @default(now())
  respondedAt        DateTime?

  @@index([ticketId, status])
  @@index([targetAdminId, status])
}

enum RemoteSupportType {
  VNC
  ANYDESK
}

model TicketAttachment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileSize  Int
  createdAt DateTime @default(now())
}

model TicketComment {
  id             String        @id @default(uuid())
  ticketId       String
  ticket         Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId       String?
  author         AdminAccount? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorUsername String        @default("unknown")
  authorName     String        @default("Unknown user")
  content        String
  createdAt      DateTime      @default(now())

  @@index([ticketId])
  @@index([authorId])
}

model KnowledgeArticle {
  id          String                @id @default(uuid())
  title       String
  problem     String
  solution    String
  keywords    String                @default("")
  authorId    String?
  author      AdminAccount?         @relation("KnowledgeArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String
  attachments KnowledgeAttachment[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([createdAt])
  @@index([authorId])
}

model KnowledgeAttachment {
  id        String           @id @default(uuid())
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime         @default(now())

  @@index([articleId])
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  DEBUG
}

enum LogSource {
  FRONTEND
  BACKEND
  DATABASE
  API
}

model ApplicationLog {
  id           String    @id @default(uuid())
  userId       String?
  level        LogLevel
  source       LogSource
  message      String
  details      Json?
  stackTrace   String?
  duration     Int?
  timestamp    DateTime  @default(now())
  responseTime Int?
  endpoint     String?
  statusCode   Int?

  @@index([level])
  @@index([source])
  @@index([timestamp])
  @@index([userId])
}

model AdUserGroup {
  id      String  @id @default(uuid())
  userId  String
  user    AdUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId String
  group   AdGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

// Config for excluding service accounts / admin OUs from sync views
model AdSyncExclusionRule {
  id        String   @id @default(uuid())
  pattern   String // e.g. "OU=ServiceAccounts,*" or "Admin_*"
  type      String // "OU" | "GROUP" | "USER"
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// 3. FILE SERVER HIERARCHY
// ---------------------------------------------------------

model DepartmentFolder {
  id            String   @id @default(uuid())
  name          String   @unique
  uncPath       String   @unique // e.g. \\fileserver\CompanyData\Finance
  lastScannedAt DateTime @default(now())

  onboardingRequests OnboardingRequest[]
}

// ---------------------------------------------------------
// 4. ONBOARDING WORKFLOW
// ---------------------------------------------------------

enum OnboardingStep {
  PENDING
  AD_USER_CREATED
  AD_GROUPS_ASSIGNED
  FOLDER_CREATED
  NTFS_PERMISSIONS_SET
  COMPLETED
  FAILED
}

model OnboardingRequest {
  id                 String            @id @default(uuid())
  firstName          String
  lastName           String
  username           String            @unique
  email              String
  targetOuDn         String
  managerDn          String?
  departmentFolderId String?
  departmentFolder   DepartmentFolder? @relation(fields: [departmentFolderId], references: [id])
  requestedGroups    String[] // group DNs
  status             OnboardingStep    @default(PENDING)
  errorMessage       String?
  createdAdUserId    String?
  createdAdUser      AdUser?           @relation(fields: [createdAdUserId], references: [id])
  createdFolderPath  String?
  logs               OnboardingLog[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model OnboardingLog {
  id                  String            @id @default(uuid())
  onboardingRequestId String
  onboardingRequest   OnboardingRequest @relation(fields: [onboardingRequestId], references: [id], onDelete: Cascade)
  step                OnboardingStep
  success             Boolean
  message             String
  createdAt           DateTime          @default(now())

  @@index([onboardingRequestId])
}
